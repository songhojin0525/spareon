{
  "name": "@spareon/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/db.ts migrate",
    "db:rollback": "tsx src/bin/db.ts rollback",
    "db:status": "tsx src/bin/db.ts status",
    "db:seed": "tsx src/bin/seed.ts",
    "dev:server": "tsx src/bin/dev-server.ts",
    "demo": "tsx src/bin/demo.ts",
    "cli": "tsx src/bin/cli.ts",
    "env:example": "tsx src/bin/env-example.ts"
  },
  "dependencies": {
    "@fastify/websocket": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@spareon/protocol": "workspace:*",
    "@spareon/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apidevtools/openapi-schemas": "catalog:",
    "@spareon/testkit": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "ajv": "catalog:",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
