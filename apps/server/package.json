{
  "name": "@binjari/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/db.ts migrate",
    "db:rollback": "tsx src/bin/db.ts rollback",
    "db:status": "tsx src/bin/db.ts status",
    "db:seed": "tsx src/bin/seed.ts"
  },
  "dependencies": {
    "@binjari/protocol": "workspace:*",
    "@binjari/shared": "workspace:*",
    "@fastify/websocket": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binjari/testkit": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "fast-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
