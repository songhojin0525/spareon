# Spareon server environment (apps/server). Generated by `pnpm --filter @spareon/server env:example`
# from src/config.ts — edit the descriptions there, not here. Copy to .env and fill in; never commit .env.

# development | test | production. Unset counts as production: development conveniences must be switched on explicitly. Default: production.
NODE_ENV=

# Listen address. 0.0.0.0 opens the server to the network. Default: 127.0.0.1.
HOST=

# Listen port. Default: 8080.
PORT=

# pino log level. Buyer content and credentials are redacted at every level. Default: info.
LOG_LEVEL=

# PostgreSQL connection URL (session mode: the scheduler holds a lock). (required)
DATABASE_URL=

# Database role every session runs as. Only spareon_app is accepted. Default: spareon_app.
DB_ROLE=

# Secret for CSRF tokens and IP hashes (32+ printable characters). Changing it invalidates CSRF tokens. (required)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# A login session ends after this many days without use (T34). Default: 7.
SESSION_IDLE_DAYS=

# A login session ends this many days after login, used or not (T34). Default: 30.
SESSION_ABSOLUTE_DAYS=

# HMAC key for stored buyer API key hashes (32+ printable characters). Losing it invalidates every API key. (required)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=

# Id of API_KEY_PEPPER, stored with each key hash (rotation). Default: p1.
API_KEY_PEPPER_ID=

# AES-256-GCM key for buyer content at rest (64 lowercase hex). Keep it apart from database backups. (required)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Id of DATA_ENCRYPTION_KEY, stored with each ciphertext. (required)
DATA_ENCRYPTION_KEY_ID=k1

# Public URL of this server (buyer API and agents connect here). https in production. (required)
PUBLIC_BASE_URL=https://api.example.com

# Origin of the web app. State-changing cookie requests must come from it (CSRF). https in production. (required)
WEB_ORIGIN=https://app.example.com

# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs, ADR 0012). Unset: the socket address is the client.
TRUST_PROXY=

# Only test is allowed: live refuses to start (absolute rule 2). Default: test.
PAYMENTS_MODE=

# Must stay unset or false: true refuses to start (no cash-out before legal review).
CASHOUT_ENABLED=

# External model providers. Only mock is available until S16. Default: mock.
EXTERNAL_PROVIDERS=

# Development only: shared secret for demo agents. Refused in production.
DEV_AGENT_SECRET=

# Development only: 1 enables /dev outside development. Refused in production.
DEV_DASHBOARD=

# Removed in S05: must be unset (buyer API keys are created with the CLI).
DEV_API_KEY=
