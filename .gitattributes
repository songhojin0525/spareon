# Normalize all text to LF in the repo and in working trees (gofmt and Prettier require LF).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.exe binary
*.dll binary
*.msi binary
*.gguf binary
*.bin binary
*.woff binary
*.woff2 binary
*.ttf binary
