{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.binjari.invalid/protocol/http/enroll.start.request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "agentVersion", "protocolHash"],
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$"
    },
    "agentVersion": {
      "$ref": "../defs/common.json#/$defs/semver"
    },
    "protocolHash": {
      "$ref": "../defs/common.json#/$defs/sha256"
    }
  }
}
