{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spareon.invalid/protocol/messages/job.cancel.json",
  "$ref": "../envelope.json",
  "properties": {
    "type": {
      "const": "job.cancel"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "reason"],
      "properties": {
        "attemptId": {
          "$ref": "../defs/common.json#/$defs/attemptId"
        },
        "reason": {
          "type": "string",
          "enum": ["buyerCanceled", "deadline", "superseded", "operator"]
        }
      }
    }
  },
  "not": {
    "required": ["corr"]
  }
}
