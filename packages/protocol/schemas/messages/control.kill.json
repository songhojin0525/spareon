{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spareon.invalid/protocol/messages/control.kill.json",
  "$ref": "../envelope.json",
  "properties": {
    "type": {
      "const": "control.kill"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "reason"],
      "properties": {
        "scope": {
          "$ref": "../defs/common.json#/$defs/controlScope"
        },
        "reason": {
          "$ref": "../defs/common.json#/$defs/controlReason"
        }
      }
    }
  },
  "not": {
    "required": ["corr"]
  }
}
