{
  "description": "Strict JSON and canonical JSON vectors. TS and Go must agree on every case (input is UTF-8 text, or raw bytes in inputHex).",
  "cases": [
    {
      "name": "sorts keys",
      "input": "{\"b\":1,\"a\":[true,false,null],\"c\":\"x\"}",
      "strict": "ok",
      "canonical": "{\"a\":[true,false,null],\"b\":1,\"c\":\"x\"}"
    },
    {
      "name": "drops whitespace",
      "input": " { \"a\" : 1 ,\n\t\"b\" : [ ] }\r\n",
      "strict": "ok",
      "canonical": "{\"a\":1,\"b\":[]}"
    },
    {
      "name": "minimal string escapes",
      "input": "{\"s\":\"\\u0041\\/\\b\\f\\n\\r\\t\\\"\\\\\\u001f\\u007f\\u2028\"}",
      "strict": "ok",
      "canonical": "{\"s\":\"A/\\b\\f\\n\\r\\t\\\"\\\\\\u001f \"}"
    },
    {
      "name": "surrogate pair escape becomes UTF-8",
      "input": "[\"\\ud83d\\ude00\"]",
      "strict": "ok",
      "canonical": "[\"😀\"]"
    },
    {
      "name": "raw non-ASCII is kept",
      "input": "{\"k\":\"한글 ü\"}",
      "strict": "ok",
      "canonical": "{\"k\":\"한글 ü\"}"
    },
    {
      "name": "html characters are not escaped",
      "input": "{\"h\":\"<a>&'\"}",
      "strict": "ok",
      "canonical": "{\"h\":\"<a>&'\"}"
    },
    {
      "name": "keys sort by UTF-16 code units, not UTF-8 bytes",
      "input": "{\"\\uff61\":1,\"\\ud83d\\ude00\":2,\"a\":3,\"B\":4,\"\":5,\"aa\":6}",
      "strict": "ok",
      "canonical": "{\"\":5,\"B\":4,\"a\":3,\"aa\":6,\"😀\":2,\"｡\":1}"
    },
    {
      "name": "safe integer range and negative zero",
      "input": "[0,-0,9007199254740991,-9007199254740991,42]",
      "strict": "ok",
      "canonical": "[0,0,9007199254740991,-9007199254740991,42]"
    },
    {
      "name": "top-level scalar",
      "input": "\"x\"",
      "strict": "ok",
      "canonical": "\"x\""
    },
    {
      "name": "depth 32 is allowed",
      "input": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "strict": "ok",
      "canonical": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
    },
    {
      "name": "integer above 2^53-1 parses but cannot be canonical",
      "input": "[9007199254740992]",
      "strict": "ok",
      "canonical": null
    },
    {
      "name": "16 digits parse but exceed the safe range",
      "input": "[-9999999999999999]",
      "strict": "ok",
      "canonical": null
    },
    {
      "name": "raw UTF-8 4-byte character",
      "inputHex": "5b22f09f9880225d",
      "strict": "ok",
      "canonical": "[\"😀\"]"
    },
    {
      "name": "fraction",
      "input": "[1.0]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "exponent",
      "input": "[1e3]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "negative exponent",
      "input": "[-1E-2]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "half",
      "input": "{\"t\":0.5}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "17 digits",
      "input": "[12345678901234567]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "leading zero",
      "input": "[01]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "lone minus",
      "input": "[-]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "negative leading zero",
      "input": "[-01]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "duplicate key",
      "input": "{\"a\":1,\"a\":2}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "duplicate key after unescaping",
      "input": "{\"a\":1,\"\\u0061\":2}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "nested duplicate key",
      "input": "{\"x\":{\"k\":1,\"k\":1}}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "lone high surrogate escape",
      "input": "[\"\\ud800\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "lone low surrogate escape",
      "input": "[\"\\udc00\"]",
      "strict": "reject",
