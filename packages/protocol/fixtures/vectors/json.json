    },
    {
      "name": "high surrogate followed by non-surrogate escape",
      "input": "[\"\\ud800\\u0041\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "reversed surrogate pair",
      "input": "[\"\\ude00\\ud83d\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "byte order mark",
      "inputHex": "efbbbf7b7d",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "invalid UTF-8 byte",
      "inputHex": "5b22ff225d",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "overlong UTF-8",
      "inputHex": "5b22c0af225d",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "UTF-8 encoded surrogate (CESU-8)",
      "inputHex": "5b22eda080225d",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "truncated UTF-8",
      "inputHex": "5b22e282225d",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "depth 33",
      "input": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "trailing comma in array",
      "input": "[1,]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "trailing comma in object",
      "input": "{\"a\":1,}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "trailing data",
      "input": "{} {}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "two values",
      "input": "1 2",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "raw tab in string",
      "input": "[\"a\tb\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "raw newline in string",
      "input": "[\"a\nb\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "invalid escape",
      "input": "[\"\\x41\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "short unicode escape",
      "input": "[\"\\u12\"]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "non-breaking space as whitespace",
      "input": "[ 1]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "form feed as whitespace",
      "input": "[\f1]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "capitalised literal",
      "input": "[True]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "truncated literal",
      "input": "[nul]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "empty input",
      "input": "",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "only whitespace",
      "input": " \n",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "NaN",
      "input": "[NaN]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "Infinity",
      "input": "[Infinity]",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "single quotes",
      "input": "{'a':1}",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "unterminated string",
      "input": "[\"abc",
      "strict": "reject",
      "canonical": null
    },
    {
      "name": "missing colon",
      "input": "{\"a\" 1}",
      "strict": "reject",
      "canonical": null
    },
    {
