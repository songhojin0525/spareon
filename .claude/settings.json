    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(sudo rm:*)",
      "Read(./.env)",
      "Read(./.env.production)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node scripts/statusline.mjs",
    "refreshInterval": 60
  }
