      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git init:*)",
      "Bash(git remote -v:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(curl:*)",
      "Bash(psql:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(pwsh:*)",
      "Bash(powershell:*)",
      "Bash(bash scripts/:*)",
      "Bash(sh scripts/:*)",
      "Bash(make:*)",
      "Bash(git clone:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(whoami:*)",
      "Bash(net session:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(printf:*)"
